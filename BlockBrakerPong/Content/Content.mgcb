
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

# The raw font file is referenced by the .spritefont files below via their
# <FontName> element. It must NOT have a /build: entry, otherwise mgcb tries to
# import it as content and fails (MSB3073).
#begin dejavusansmono.ttf
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color

#begin buttonfont.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:buttonfont.spritefont

#begin gamefont.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:gamefont.spritefont

#begin ping1.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/processorParam:DebugMode=False
/build:ping1.wav

#begin ping2.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/processorParam:DebugMode=False
/build:ping2.wav

#begin paddleHit.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/processorParam:DebugMode=False
/build:paddleHit.wav

#begin blockBreak.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/processorParam:DebugMode=False
/build:blockBreak.wav

#begin wallBounce.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/processorParam:DebugMode=False
/build:wallBounce.wav

#begin gameOver.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/processorParam:DebugMode=False
/build:gameOver.wav

#begin levelClear.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/processorParam:DebugMode=False
/build:levelClear.wav
